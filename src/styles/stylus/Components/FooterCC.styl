footer .wrap{display:grid;gap:36px;padding-block:64px 40px}
.foot-top{display:flex;flex-wrap:wrap;justify-content:space-between;gap:32px}
.foot-links{display:grid;grid-template-columns:repeat(2,minmax(0,auto));gap:10px 48px}
.foot-links a{text-decoration:none;color:var(--muted)}
.foot-links a:hover{color:var(--fg)}
.legal{border-top:1px solid var(--line);padding-top:24px;display:grid;gap:8px;font-size:13px;color:var(--muted)}

