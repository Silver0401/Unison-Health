.hero{padding-top:clamp(48px,8vw,104px);padding-bottom:clamp(220px,30vw,360px);overflow:hidden}
.hero .wrap{display:grid;gap:28px}
.hero h1{font-size:clamp(42px,7.4vw,96px);max-width:14ch}
.hero h1 .accent{color:var(--cobalto)}
.hero h1 .dot{display:inline-block;width:.2em;height:.2em;border-radius:50%;background:var(--coral);margin-left:.04em;vertical-align:.08em}
.hero .lead{max-width:52ch}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px}
.hero-meta{display:flex;flex-wrap:wrap;gap:8px 18px;font-size:14px;color:var(--muted)}
.hero-meta span{display:inline-flex;align-items:center;gap:8px}
.hero-meta span::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--azul)}
.stagger>*{animation:rise 1s var(--ease) both}
.stagger>*:nth-child(2){animation-delay:.12s}
.stagger>*:nth-child(3){animation-delay:.24s}
.stagger>*:nth-child(4){animation-delay:.36s}
.stagger>*:nth-child(5){animation-delay:.48s}
.unison{display:block;width:100%;height:clamp(180px,26vw,320px);margin-top:clamp(24px,5vw,56px)}
.quotes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:48px}
.quotes-compact{margin-top:24px}
.quote{margin:0;padding:28px;border-radius:20px;background:var(--card);display:flex;flex-direction:column;gap:18px;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.quote p{font:400 21px/1.35 var(--display)}
.quote small{font-size:14px;color:var(--muted)}
.problem-title{font-size:clamp(28px,3.8vw,46px);margin-top:56px;max-width:26ch}
.answer{margin-top:28px;display:flex;align-items:center;gap:14px;font:600 clamp(22px,3vw,30px)/1.2 var(--display)}
.answer::before{content:"";flex:none;width:14px;height:14px;border-radius:50%;background:var(--coral)}
.split{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(32px,6vw,80px);align-items:start}
.split h2,.record h2{font-size:clamp(34px,5vw,60px)}
.heading-spaced{margin-top:16px}
.split .lead,.record .lead{margin-top:20px}
.pillars{display:grid;gap:16px}
.featured{background:#fff;color:var(--tinta);border-radius:24px;padding:clamp(28px,4vw,44px);display:grid;gap:16px}
.featured .tag{display:inline-flex;width:max-content;padding:6px 12px;border-radius:999px;background:#E8EEFB;color:var(--cobalto);font:500 13px/1 var(--body)}
.featured h3{font-size:clamp(26px,3vw,36px)}
.featured p{color:#475569}
.pillar{display:grid;grid-template-columns:auto minmax(0,1fr);gap:18px;padding:26px 4px;border-top:1px solid var(--line)}
.pillar svg{width:40px;height:40px}
.pillar h3{font-size:24px;margin-bottom:6px}
.pillar p,.person p,.service p,.service ul,.value p{color:var(--muted)}
.record{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(32px,6vw,80px);align-items:center}
.checks{list-style:none;padding:0;margin:28px 0 0;display:grid;gap:14px}
.checks li{display:grid;grid-template-columns:22px minmax(0,1fr);gap:12px;align-items:start}
.checks li::before{content:"";width:10px;height:10px;margin-top:9px;border-radius:50%;background:var(--coral)}
.shot{margin:0;max-width:440px;box-shadow:0 30px 80px rgba(0,0,0,.4);border-radius:28px;overflow:hidden}
.shot img{display:block;width:100%;height:auto}
.caption{margin-top:14px;font-size:13px;color:var(--muted)}
.record-button{margin-top:20px}
.steps-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:20px}
.steps-head h2{font-size:clamp(34px,5vw,60px);max-width:16ch}
.steps{list-style:none;padding:0;margin:56px 0 0;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:18px;counter-reset:s;position:relative}
.steps::before{content:"";position:absolute;left:0;right:0;top:21px;height:2px;background:var(--line)}
.steps li{position:relative;display:grid;gap:12px;align-content:start}
.steps li::before{counter-increment:s;content:counter(s);display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--cobalto);color:#fff;font:600 17px/1 var(--display);position:relative}
.steps li:last-child::before{background:var(--coral);color:var(--tinta)}
.steps h3{font-size:21px}
.steps p{color:var(--muted);font-size:16px}
.section-title{font-size:clamp(34px,5vw,60px);margin-top:16px;max-width:18ch}
.team{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:48px}
.person{display:grid;grid-template-columns:150px minmax(0,1fr);gap:24px;padding:24px;border-radius:24px;background:var(--card)}
.photo{aspect-ratio:4/5;max-width:100%;border-radius:16px;background:linear-gradient(160deg,#5B8DEF,#1E40AF);display:grid;place-items:center;color:#fff;font:600 40px/1 var(--display);position:relative;overflow:hidden}
.person h3{font-size:26px}
.person .role{color:var(--cobalto);font-weight:500;margin:6px 0 12px}
.person p{font-size:16px}
.cred{margin-top:14px;padding-top:14px;border-top:1px solid var(--line);font-size:14px!important}
.person-button{margin-top:16px}
.values{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:18px;margin-top:48px}
.value{padding-top:20px;border-top:2px solid var(--fg)}
.value h3{font-size:21px;margin-bottom:8px}
.value p{font-size:15px}
.services-title{max-width:20ch}
.services{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:48px}
.service{background:var(--card);border-radius:24px;padding:30px;display:flex;flex-direction:column;gap:14px}
.service.main{background:var(--cobalto);color:#fff}
.service.main p,.service.main li{color:#DCE6FF}
.service h3{font-size:26px}
.service ul{margin:0;padding-left:18px;display:grid;gap:6px;font-size:15px}
.service-tag{display:inline-flex;width:max-content;padding:6px 12px;border-radius:999px;background:#FF7A59;color:#0F172A;font:600 13px/1 var(--body)}
.price{margin-top:auto;padding-top:12px;font:600 22px/1 var(--display)}
.price small{display:block;font:400 13px/1.4 var(--body);opacity:.75;margin-top:6px}
.services-note{margin-top:20px;font-size:14px;color:var(--muted)}
.cta{text-align:left}
.cta h2{font-size:clamp(40px,7vw,88px);max-width:13ch}
.cta .lead{margin-top:20px}
.cta-row{display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px;margin-top:36px}
.phone{font:500 18px/1.4 var(--body);user-select:all}
@media(max-width:960px){.split,.record{grid-template-columns:minmax(0,1fr)}
.quotes{grid-template-columns:minmax(0,1fr)}
.steps{grid-template-columns:minmax(0,1fr);gap:26px}
.steps::before{left:21px;right:auto;top:0;bottom:0;width:2px;height:auto}
.steps li{grid-template-columns:44px minmax(0,1fr);column-gap:16px}
.steps li>*{grid-column:2}
.steps li::before{grid-row:1/span 2}
.team{grid-template-columns:minmax(0,1fr)}
.values{grid-template-columns:repeat(2,minmax(0,1fr))}
.services{grid-template-columns:minmax(0,1fr)}
.nav{display:none}
.menu-btn{display:grid;place-items:center}
}
@media(max-width:560px){body{font-size:16px}
.person{grid-template-columns:minmax(0,1fr)}
.photo{max-width:180px}
.values{grid-template-columns:minmax(0,1fr)}
.top .btn-sm{display:none}
}

